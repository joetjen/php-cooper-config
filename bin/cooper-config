#!/usr/bin/env php
<?php

declare(strict_types=1);

// Installed, Composer's bin proxy names the autoloader; run from a
// checkout of this package, it is the package's own.
$autoload = $GLOBALS['_composer_autoload_path'] ?? null;
foreach ([$autoload, __DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $candidate) {
    if (is_string($candidate) && is_file($candidate)) {
        require $candidate;
        break;
    }
}
if (!class_exists(JOetjen\CooperConfig\Cli::class)) {
    fwrite(STDERR, "cooper-config: cannot find Composer's autoloader -- run composer install\n");
    exit(1);
}

exit(JOetjen\CooperConfig\Cli::application()->run(JOetjen\CooperConfig\Cli::input(array_values($argv))));
